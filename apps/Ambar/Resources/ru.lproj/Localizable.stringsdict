			<key>one</key>
			<string>%lld запись</string>
			<key>other</key>
			<string>%lld записи</string>
		</dict>
	</dict>
	<key>settings.dictionary.count</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>few</key>
			<string>%lld термина</string>
			<key>many</key>
			<string>%lld терминов</string>
			<key>one</key>
			<string>%lld термин</string>
			<key>other</key>
			<string>%lld термина</string>
		</dict>
	</dict>
	<key>settings.dictionary.uses</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>few</key>
			<string>%lld использования</string>
			<key>many</key>
			<string>%lld использований</string>
			<key>one</key>
			<string>%lld использование</string>
			<key>other</key>
			<string>%lld использования</string>
		</dict>
	</dict>
	<key>settings.retention.days</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@days@</string>
		<key>days</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>few</key>
			<string>Хранить %lld дня</string>
			<key>many</key>
			<string>Хранить %lld дней</string>
			<key>one</key>
